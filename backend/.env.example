# ============================================================
# Cò Con Dự Báo — Backend (Express API on Railway)
# Copy this file to backend/.env and fill in real values.
# NEVER commit the real .env (it is gitignored).
# ============================================================

# --- Supabase (Postgres 17 + pgvector + Storage) ---
# Project ref + keys from Supabase dashboard → Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role key — bypasses RLS, server-side ONLY, keep secret>
SUPABASE_ANON_KEY=<anon public key>

# --- Google Gemini (embeddings + text generation + vision + STT) ---
# One key for all models. Free tier quota is low (~tens of generate req/day per model).
GOOGLE_API_KEY=<Gemini API key>
# Optional: quotaMonitor warns to Sentry at 80% of these (per minute / per day).
GEMINI_RPM_LIMIT=15
GEMINI_RPD_LIMIT=200

# --- Auth ---
# Long random string used to sign self-signed JWTs (e.g. `openssl rand -hex 32`).
JWT_SECRET=<long-random-secret>

# --- Web Push (VAPID) ---
# Generate a key pair once with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY must match the frontend's VITE_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=<vapid public key>
VAPID_PRIVATE_KEY=<vapid private key>
VAPID_CONTACT=mailto:you@example.com

# --- App ---
FRONTEND_URL=http://localhost:5173          # CORS allow-list origin; prod: https://cocondubao.vercel.app
PORT=3000
NODE_ENV=development                        # set to "production" on Railway

# --- Observability (optional) ---
SENTRY_DSN=

# NOTE: SMS OTP is handled by Supabase Auth (Twilio is configured inside the
# Supabase dashboard, not here), so no TWILIO_* variables are needed.
