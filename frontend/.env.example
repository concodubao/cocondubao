# ============================================================
# Cò Con Dự Báo — Frontend (React PWA on Vercel)
# Copy this file to frontend/.env.local and fill in real values.
# WARNING: every VITE_* var is bundled into the browser build.
# Put ONLY public keys here — never a service-role key or secret.
# ============================================================

# Backend REST API base URL — INCLUDES the /api/v1 path.
VITE_API_URL=http://localhost:3000/api/v1     # prod: https://<your-railway-app>.up.railway.app/api/v1

# --- Supabase (anon/public key only — used by services/supabase.js) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>

# --- Web Push public key (must match backend VAPID_PUBLIC_KEY) ---
VITE_VAPID_PUBLIC_KEY=<vapid public key>

# --- Observability (optional) ---
VITE_SENTRY_DSN=
